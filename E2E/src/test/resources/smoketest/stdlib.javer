fn void printf(string format, struct Object ... o) {
    let int i;
    let int j;
    for(i = 0, j = 0; i < format.length; i++) {
        let char c = format[i];
        switch(c) {
            case '%': {
                i++;
                if(i >= format.length) break;
                c = format[i];
                switch(c) {
                    case 'i': call printi((cast (struct Int)o[j++]).value);
                    case 's': call prints((cast (struct String)o[j++]).value);
                    case 'c': call printc((cast (struct Char)o[j++]).value);
                    case 'd': call printd((cast (struct Double)o[j++]).value);
                    case 'b': call prints((cast (struct Boolean)o[j++]).value ? "true" : "false");
                    default: call printc(c);
                }
            }
            default: {
                call printc(c);
            }
        }
    }
}

fn void Object_print(struct Object o) {
    switch(o.type) {
        case DataType.INT:      call printi((cast (struct Int)o).value);
        case DataType.DOUBLE:   call printd((cast (struct Double)o).value);
        case DataType.STRING:   call prints((cast (struct String)o).value);
        case DataType.CHAR:     call printc((cast (struct Char)o).value);
        case DataType.BOOLEAN:  call printb((cast (struct Boolean)o).value);
    }
}
