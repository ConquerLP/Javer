fn void main() {
    call move_fast(0.0, 0.0, 10.0);
    call driveBool("cylinder.front", "extend", true);
    call move_linear(10.0, 0.0, 0.0, 500);
    call driveDouble("laser.main", "power", 0.75);
    call move_ccw(20.0, 0.0, 0.0, 5.0, 200);
    call wait_ms(250);
    let double pressure = call readDouble("hydraulics.clamp", "pressure");
    call printd(pressure);
    call driveDouble("laser.main", "power", 0.0);
}
